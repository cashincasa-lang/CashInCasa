+  .bottombar{display:grid;grid-template-columns:repeat(5,1fr);position:fixed;left:0;right:0;bottom:0;z-index:30;padding:8px 2px calc(8px + env(safe-area-inset-bottom));border-top:1px solid var(--glass-line)}
+  .nb{padding:0}
+  .top{padding:calc(10px + env(safe-area-inset-top)) 12px 0}
+  .searchbar input{height:44px}
+  .tabs{gap:22px;margin:4px -12px 0;padding:0 12px}
+  .tabs button{height:46px;font-size:15px}
+  .page{padding:12px 12px calc(110px + env(safe-area-inset-bottom))}
+  .narrow{padding:calc(20px + env(safe-area-inset-top)) 16px calc(110px + env(safe-area-inset-bottom))}
+  .page-title{font-size:26px}
+  .modal{place-items:end center;padding:0}
+  .sheet{width:100%;border-radius:28px 28px 0 0;padding:10px 16px calc(20px + env(safe-area-inset-bottom));max-height:92dvh;animation:up .24s ease-out}
+  .grab{display:block;width:36px;height:4px;border-radius:2px;background:rgba(16,48,36,.22);margin:0 auto 6px}
+  .sheet--wide{padding:0 0 calc(16px + env(safe-area-inset-bottom));width:100%}
+  .sheet--wide .grab{position:absolute;top:8px;left:50%;translate:-50% 0;z-index:3;background:rgba(255,255,255,.85)}
+  .dbody{padding:16px 18px 4px}
+  .dacts .btn{flex:1 1 auto}
+  .frow{grid-template-columns:1fr}
+  .share-form{grid-template-columns:1fr 1fr}.share-form input{grid-column:1/-1}
+  .task{grid-template-columns:auto minmax(0,1fr) auto}
+  .task .attach{grid-column:1/-1;grid-row:2}.task>.icon-btn{grid-column:3;grid-row:1}
+  .addtask{grid-template-columns:1fr 1fr}.addtask .input:first-child{grid-column:1/-1}
 }
+@media(max-width:380px){.page-title{font-size:23px}.nb .nl{font-size:11px}}
+@media(prefers-reduced-motion:reduce){.modal,.sheet,.pin-media,.nb .ind{animation:none!important;transition:none!important}}
